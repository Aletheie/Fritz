# Enable server-only AI for a private instance with AI_SPONSORED_MODE=private.
AI_SPONSORED_MODE=off
AI_BUDGET_STORE=

# One-account auth data. Create it with: pnpm account:create
FRITZ_AUTH_DATA_DIR=./data

# Optional server key for an explicit private development deployment only.
# Never rename this to PUBLIC_*.
GEMINI_API_KEY=

# Stable model used by Fritz's focused vocabulary tools.
AI_MODEL=gemini-3.6-flash

# Optional private provider; Gemini takes priority when both are configured, with no fallback.
INKLING_API_KEY=
INKLING_BASE_URL=
INKLING_MODEL=thinkingmachines/Inkling-NVFP4
INKLING_ALLOWED_HOSTS=
TRUST_CUSTOM_AI_PROVIDER=false

# Signed-in users can connect their own Gemini, Anthropic or compatible API in Settings.
AI_USER_CONNECTIONS=on
# Optional 32-byte hex/base64url master key. Empty = generated in the persistent auth data dir.
AI_KEY_ENCRYPTION_SECRET=
# Allows only server loopback for local Ollama / LM Studio (not LAN or cloud metadata).
AI_ALLOW_LOCAL_PROVIDERS=false
