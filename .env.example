# Public deployments remain demo. Private single-owner deployments may opt into
# server-only AI with AI_SPONSORED_MODE=private.
AI_SPONSORED_MODE=off
AI_BUDGET_STORE=

# One-account auth data. Create it with: pnpm account:create
FRITZ_AUTH_DATA_DIR=./data

# Optional server key for an explicit private development deployment only.
# Never rename this to PUBLIC_*.
GEMINI_API_KEY=

# Stable model used by Fritz's focused vocabulary tools.
AI_MODEL=gemini-3.6-flash

# Optional private-deployment provider. Cross-vendor fallback additionally needs
# feature-specific consent in Settings. No URL means this provider is disabled.
INKLING_API_KEY=
INKLING_BASE_URL=
INKLING_MODEL=thinkingmachines/Inkling-NVFP4
INKLING_ALLOWED_HOSTS=
TRUST_CUSTOM_AI_PROVIDER=false
