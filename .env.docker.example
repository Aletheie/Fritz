# Port otevřený na hostiteli. ORIGIN musí odpovídat adrese v prohlížeči.
WORTLY_PORT=3000
ORIGIN=http://localhost:3000
WORTLY_AUTH_DATA_DIR=/data

# Create the one allowed account after the container starts:
# docker compose exec app node scripts/account-create.mjs

# Veřejný default je demo; pro server-only AI nastav private a vlož GEMINI_API_KEY.
AI_SPONSORED_MODE=off
AI_BUDGET_STORE=

# Volitelný serverový klíč. Web ho nikdy nepřijímá ani nezobrazuje.
GEMINI_API_KEY=
AI_MODEL=gemini-3.6-flash

# Volitelný provider pro explicitní privátní deployment. Cross-vendor fallback
# navíc vyžaduje souhlas pro konkrétní funkci v Nastavení.
INKLING_API_KEY=
INKLING_BASE_URL=
INKLING_MODEL=thinkingmachines/Inkling-NVFP4
INKLING_ALLOWED_HOSTS=
TRUST_CUSTOM_AI_PROVIDER=false
