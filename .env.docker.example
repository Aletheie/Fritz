# Port otevřený na hostiteli. ORIGIN musí odpovídat adrese v prohlížeči.
# Výchozí přístup je pouze z tohoto počítače; HTTPS proxy připoj na 127.0.0.1.
FRITZ_BIND_HOST=127.0.0.1
FRITZ_PORT=3000
ORIGIN=http://localhost:3000
FRITZ_AUTH_DATA_DIR=/data
FRITZ_DATA_VOLUME=fritz-data

# Create the one allowed account after the container starts:
# docker compose exec app node scripts/account-create.mjs

# Pro živé AI odpovědi nastav private a vlož GEMINI_API_KEY.
AI_SPONSORED_MODE=off
AI_BUDGET_STORE=

# Připojení vlastního poskytovatele v Nastavení → AI. Klíč je šifrovaný v HttpOnly cookie.
# Prázdný encryption secret vygeneruje soukromý klíč v datovém volume /data.
AI_USER_CONNECTIONS=true
AI_KEY_ENCRYPTION_SECRET=
# Povol pouze pro důvěryhodnou soukromou instanci. Loopback zde znamená kontejner.
AI_ALLOW_LOCAL_PROVIDERS=false

# Volitelný serverový klíč. Web ho nikdy nepřijímá ani nezobrazuje.
GEMINI_API_KEY=
AI_MODEL=gemini-3.6-flash

# Volitelný privátní provider; při souběhu má přednost Gemini, bez náhradního poskytovatele.
INKLING_API_KEY=
INKLING_BASE_URL=
INKLING_MODEL=thinkingmachines/Inkling-NVFP4
INKLING_ALLOWED_HOSTS=
TRUST_CUSTOM_AI_PROVIDER=false
